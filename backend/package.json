{
  "name": "recallos-backend",
  "version": "0.1.0",
  "description": "RecallOS backend - local-first AI memory and context layer",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "bench": "tsx src/bench/scenarios.ts",
    "bench:verbatim": "tsx src/bench/verbatim-scenarios.ts",
    "bench:eval": "tsx src/bench/hybrid-eval.ts",
    "bench:regression": "tsx src/bench/regression-tests.ts",
    "bench:context": "tsx src/bench/context-relevance.ts",
    "bench:modules": "tsx src/bench/module-tests.ts",
    "bench:e2e": "tsx src/bench/e2e-tests.ts",
    "bench:longmemeval": "tsx src/bench/longmemeval.ts",
    "bench:all": "npm run bench && npm run bench:verbatim && npm run bench:eval && npm run bench:regression && npm run bench:context && npm run bench:modules && npm run bench:e2e",
    "mcp": "tsx src/mcp-server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xenova/transformers": "^2.17.2",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "openai": "^4.77.0",
    "sql.js": "^1.11.0",
    "uuid": "^11.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
